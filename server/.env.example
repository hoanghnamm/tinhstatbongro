# Railway: set DATABASE_URL on the SERVER service to ${{Postgres.DATABASE_URL}}
# (use the exact database service name). Railway supplies PORT separately.
# Locally, point DATABASE_URL at your own Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hooprec
PORT=8080

# Where a magic link points. The app opens it and posts the token to /auth/verify.
APP_LINK_BASE=https://hooprec.app/signin

# Mail. With no key, sign-in links are printed to the log instead of sent.
# The app's email-code sign-in requires this key; codes are never logged.
RESEND_API_KEY=
MAIL_FROM=HoopRec <login@hooprec.app>

# Must match EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID in livestats/.env
REVENUECAT_ENTITLEMENT_ID=pro
# RevenueCat dashboard -> Integrations -> Webhooks -> Authorization header value.
# The webhook REFUSES every request until this is set.
REVENUECAT_WEBHOOK_SECRET=
# Accept SANDBOX events. On for a staging box, off in production.
REVENUECAT_ACCEPT_SANDBOX=false

# Browser origins for the web build, comma separated. Empty means none.
ALLOWED_ORIGINS=

# DEV ONLY: return the sign-in link in the HTTP response instead of mailing it.
ALLOW_DEV_LOGIN=false
